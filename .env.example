VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
VITE_WEB_PUSH_PUBLIC_KEY=your-vapid-public-key

# Optional sign-in providers. Each stays hidden in the account sheet until the
# matching provider is actually configured in the Supabase project, so nobody
# can walk into a flow the backend cannot finish. Set to 1 to show.
VITE_AUTH_PHONE_ENABLED=0
VITE_AUTH_APPLE_ENABLED=0

# Membership entitlements. Keep 0 until a payment channel is connected; the
# entry point is hidden while the only plan is the free tier.
VITE_MEMBERSHIP_ENABLED=0
